@{
    # Настройки PSScriptAnalyzer для проекта WindowsConfigurator.
    #
    # Включены ВСЕ правила по умолчанию, кроме перечисленных ниже. Каждое
    # исключение обосновано - см. комментарии. Точечные отклонения (например
    # полиморфный OutputType или централизованный ShouldProcess) подавлены
    # атрибутами SuppressMessageAttribute непосредственно в коде функций,
    # а не глобальным отключением правил.
    # Запускаем стандартный набор правил PSScriptAnalyzer (без опциональных
    # правил форматирования: PSAlignAssignmentStatement, PSPlaceOpenBrace и т.п. -
    # стиль кода в проекте выровнен вручную и проверяется тестами структуры).
    IncludeDefaultRules = $true

    ExcludeRules = @(
        # Проект - интерактивная консольная утилита для админов: цветной вывод
        # в консоль намеренный. Весь вывод идёт через единственную функцию
        # Write-Log (она дублирует сообщения в файл), а также через отрисовку
        # меню (Show-InteractiveMenu / Show-InstallationSubmenu) и итоговую
        # сводку точки входа. Правило PSAvoidUsingWriteHost для такого класса
        # инструментов неприменимо, а собственный тест гарантирует, что
        # Write-Host НЕ используется в шагах и бизнес-логике.
        'PSAvoidUsingWriteHost',

        # Функции, возвращающие коллекцию, намеренно названы во множественном
        # числе (Get-StepDefinitions, Get-InteractiveMenuItems,
        # Remove-ExpiredLogFiles, ...): единственное число вводило бы в
        # заблуждение относительно cardinality результата.
        'PSUseSingularNouns',

        # Состояние журналирования хранится в одной документированной
        # глобальной переменной $global:WindowsConfiguratorLogging. Причина:
        # функции проекта dot-source'ятся (а не оформлены модулем) ради
        # совместимости с Windows PowerShell 5.1 без сборки манифеста, поэтому
        # $script: не был бы доступен вызывающему скрипту. Доступ к состоянию
        # инкапсулирован в Initialize-Logging / Write-Log.
        'PSAvoidGlobalVars',

        # Правило срабатывает на ЛЮБОМ параметре -ComputerName, включая наш
        # собственный параметр функции Set-PowerPlanAndTimeouts (имя компьютера
        # передаётся из конфигурации/тестов, а не захардкожено). Ложные
        # срабатывают только в тестах; в продакшн-коде имя берётся через
        # Get-ComputerNameNormalized.
        'PSAvoidUsingComputerNameHardcoded',

        # Правило срабатывает на имени 'Write-Log': такой cmdlet встречается в
        # базах предпросмотровых/сторонних модулей PowerShell. Функции проекта
        # dot-source'ятся в собственную область видимости и НЕ экспортируются
        # глобально, поэтому перезаписи встроенного cmdlet не происходит;
        # подавление внутри функции это правило (уровня скрипта) не учитывает.
        'PSAvoidOverwritingBuiltInCmdlets'
    )
}

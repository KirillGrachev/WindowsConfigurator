{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Фикстура: все ключевые слова draft-07 в одном документе",
  "description": "Используется тестами валидатора. Специально exercising oneOf/anyOf/allOf/not/if-then-else/$ref одновременно.",
  "type": "object",
  "additionalProperties": false,
  "required": [ "app", "key", "plan", "targets", "menuId" ],
  "properties": {
    "app": { "$ref": "#/definitions/app" },
    "key": {
      "oneOf": [
        { "type": "string", "pattern": "^[A-Z0-9]{5}-[A-Z0-9]{5}-[A-Z0-9]{5}-[A-Z0-9]{5}-[A-Z0-9]{5}$" },
        { "$ref": "#/definitions/secret" }
      ]
    },
    "plan": { "$ref": "#/definitions/guid" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": [ "AC", "DC", "Both" ] }
    },
    "menuId": { "$ref": "#/definitions/menuItem" }
  },
  "definitions": {
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "Type" ],
      "properties": {
        "Type": { "enum": [ "MSI", "Executable", "Batch", "DISM" ] },
        "InstallerPath": { "type": "string", "minLength": 1 },
        "FeatureName": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "Type": { "const": "MSI" } }, "required": [ "Type" ] },
          "then": { "required": [ "InstallerPath" ] }
        },
        {
          "if": { "properties": { "Type": { "const": "DISM" } }, "required": [ "Type" ] },
          "then": { "required": [ "FeatureName" ] },
          "else": { "not": { "required": [ "FeatureName" ] } }
        }
      ]
    },
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "$secret" ],
      "properties": {
        "$secret": { "type": "string", "pattern": "^(env|file|dpapi):[^\\s]+$" }
      }
    },
    "guid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "menuItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "Id", "Label", "Step" ],
      "properties": {
        "Id": { "type": "string", "pattern": "^\\d{1,3}$" },
        "Label": { "type": "string", "minLength": 1 },
        "Step": { "anyOf": [ { "enum": [ "Activation", "Desktop" ] }, { "const": "RunAll" } ] },
        "RequiresUser": { "type": "boolean" }
      },
      "if": { "properties": { "RequiresUser": { "const": true } }, "required": [ "RequiresUser" ] },
      "then": { "properties": { "Step": { "not": { "const": "Activation" } } } }
    }
  }
}
